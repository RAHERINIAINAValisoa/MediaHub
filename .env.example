# Copiez ce fichier en ".env" puis adaptez les valeurs.
# Format : CLE=valeur (sans guillemets, sans "export"). Les variables d'environnement du système restent prioritaires.

# --- PostgreSQL local ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediahub
DB_USER=postgres
DB_PASSWORD=changez-moi

# --- Serveur ---
SERVER_PORT=8080

# --- Fichiers téléversés (images, vidéos, audios, avatars) ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20MB

# --- Premier démarrage (base vide) ---
# true  : importe les données de l'ancienne version (comptes de démo, médias, commentaires)
# false : crée seulement le compte administrateur ci-dessous
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@mediahub.com
# Utilisé uniquement si SEED_DEMO_DATA=false. Laissé vide : un mot de passe aléatoire est affiché dans les logs.
ADMIN_PASSWORD=
